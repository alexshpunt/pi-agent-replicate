{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["index.ts", "pi-extension/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", ".tmp", ".agents"]
}
